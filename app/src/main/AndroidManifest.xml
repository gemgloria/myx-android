<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.yexin.xiangqi">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application android:label="MYX" android:icon="@drawable/ic_launcher"
        android:theme="@style/AppTheme" android:allowBackup="false"
        android:extractNativeLibs="true" android:supportsRtl="false">
        <activity android:name=".AssistantActivity" android:exported="true"
            android:screenOrientation="portrait" android:configChanges="orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".MainActivity" android:exported="false"
            android:screenOrientation="portrait" android:configChanges="orientation|screenSize" />
        <service android:name=".FloatingService" android:exported="false"
            android:foregroundServiceType="mediaProjection" />
        <service android:name=".XiangqiGestureService" android:exported="true"
            android:label="MYX 点击辅助" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/gesture_service" />
        </service>
    </application>
</manifest>
